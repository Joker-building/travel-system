              ],
              "path": [
                "api",
                "user",
                "avatar",
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "D:/travel-system/backend/postman\\sample.png"
                }
              ]
            }
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "天气服务",
      "item": [
        {
          "name": "城市天气预报",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/weather/forecast?city=武汉&days=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "weather",
                "forecast"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "武汉"
                },
                {
                  "key": "days",
                  "value": "3"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}