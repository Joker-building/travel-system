              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/update",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "update"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nickname\": \"新昵称\", \"city\": \"宜昌\", \"gender\": \"男\", \"phone\": \"13800000000\"}",
              "options": {
