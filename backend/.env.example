# ============================================
# AI辅助个性化旅游行程定制系统 - 环境变量配置
# ============================================
# 复制本文件为 .env 并填写实际值

# ---- 数据库配置 ----
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=travel_system

# ---- JWT 配置 ----
SECRET_KEY=your_secret_key_change_this_to_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- DeepSeek API 配置 ----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---- 文件上传配置 ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE=1048576

# ---- 应用配置 ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True

# ---- 第三方 API（密钥仅在服务端，前端经 /api/proxy 调用） ----
# 和风天气
# 获取步骤：登录 https://console.qweather.com -> 进入项目 -> 左侧「设置」查看 API Host
# （形如 xxx.re.qweatherapi.com 或 api.qweather.com）->「密钥管理」复制一个有效 Key。
# 注意：自定义域名(xxx.re.qweatherapi.com)与订阅绑定，Key 必须来自同一订阅，否则返回 401/403。
# 若 Key 失效/被重置/过期，会返回 401；此时需重新复制 Key 覆盖下面的 QWEATHER_KEY 并重启后端。
QWEATHER_HOST=your_qweather_host
QWEATHER_KEY=your_qweather_key

# 高德地图（逆地理编码）
AMAP_KEY=your_amap_key

# 百度翻译
BAIDU_TRANSLATE_APPID=your_baidu_appid
BAIDU_TRANSLATE_KEY=your_baidu_key
